# --- Telegram ---
BOT_TOKEN=
# Public HTTPS address of this server (Telegram Mini Apps require https)
WEBAPP_URL=
# Comma-separated Telegram user ids that approve payments (get yours from @userinfobot)
ADMIN_IDS=
SUPPORT_USERNAME=

# --- Supplier ---
# Which supplier sells us the UC: fazercards | wdg (WDG Zone, https://wdgzone.tech/docs/)
SUPPLIER=fazercards
FAZERCARDS_API_KEY=
FAZERCARDS_BASE_URL=https://api.fzr.cards/api/v2
# WDG Zone: the key from its panel (API & Integration). WDG has no Player-ID lookup, so with SUPPLIER=wdg the
# FAZERCARDS_API_KEY above is still used to verify IDs when its plan is active (otherwise IDs go unverified, with a warning).
WDG_API_KEY=
WDG_BASE_URL=https://wdgzone.tech/api/v1
# The WDG category that holds PUBG Mobile UC by Player ID. Run /supplier in the bot (admin) to list the candidates.
WDG_PUBG_CATEGORY_ID=
# Games sold besides PUBG UC (WDG only): tg_stars, tg_premium, free_fire. List ids here to switch them off without a deploy.
DISABLED_GAMES=
# mock = never spends supplier balance, simulates delivery. live = real orders.
FULFILLMENT_MODE=mock

# --- Pricing ---
USD_UZS_RATE=12800
USD_RUB_RATE=85.5
MARKUP_PERCENT=10
ROUND_TO=100
RUB_ROUND_TO=1

# --- Payments ---
# so'm payments: mock = demo button | manual_card = customer sends a receipt, admin approves | click = automatic via Click
# (rubles are always paid by card transfer; Click only handles so'm)
PAYMENT_PROVIDER=mock
CARD_NUMBER=
CARD_HOLDER=
CARD_RUB_NUMBER=
CARD_RUB_HOLDER=
CARD_RUB_BANK=
# Click merchant keys (given by Click when the shop is connected). In the Click cabinet set BOTH the
# Prepare URL and the Complete URL to:  <WEBAPP_URL>/api/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# --- Dev ---
# 1 lets you open the web app in a normal browser without Telegram. NEVER use 1 in production.
DEV_MODE=0
DEV_USER_ID=1
