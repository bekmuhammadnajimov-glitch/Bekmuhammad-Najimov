# --- Telegram ---
BOT_TOKEN=
# Public HTTPS address of this server (Telegram Mini Apps require https)
WEBAPP_URL=
# Comma-separated Telegram user ids that approve payments (get yours from @userinfobot)
ADMIN_IDS=
SUPPORT_USERNAME=

# --- Supplier (FazerCards) ---
FAZERCARDS_API_KEY=
FAZERCARDS_BASE_URL=https://api.fzr.cards/api/v2
# mock = never spends supplier balance, simulates delivery. live = real orders.
FULFILLMENT_MODE=mock

# --- Pricing ---
USD_UZS_RATE=12800
USD_RUB_RATE=85.5
MARKUP_PERCENT=10
ROUND_TO=100
RUB_ROUND_TO=1

# --- Payments ---
# so'm payments: mock = demo button | manual_card = customer sends a receipt, admin approves | click = automatic via Click
# (rubles are always paid by card transfer; Click only handles so'm)
PAYMENT_PROVIDER=mock
CARD_NUMBER=
CARD_HOLDER=
CARD_RUB_NUMBER=
CARD_RUB_HOLDER=
CARD_RUB_BANK=
# Click merchant keys (given by Click when the shop is connected). In the Click cabinet set BOTH the
# Prepare URL and the Complete URL to:  <WEBAPP_URL>/api/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# --- Dev ---
# 1 lets you open the web app in a normal browser without Telegram. NEVER use 1 in production.
DEV_MODE=0
DEV_USER_ID=1
